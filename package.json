{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build": "npm run cap:sync && npx cap open android",
    "generate": "npm run cap:sync && powershell -NoProfile -Command \"cd android; .\\gradlew.bat assembleDebug; exit $LASTEXITCODE\"",
    "ota:publish": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-ota.ps1"
  },
  "dependencies": {
